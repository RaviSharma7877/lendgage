# ---------------------------------------------------------------------------
# Copy this file to .env.local and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# MySQL 8 connection string.
# Local default (matches docker-compose.yml):
DATABASE_URL="mysql://pcp:pcp_password@localhost:3306/provisional_certificate"
# Set to "require" when pointing at a managed MySQL (PlanetScale, RDS, Railway...).
# DB_SSL="require"

# Secret used to sign session JWTs and short-lived file-download tokens.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Where uploaded PDFs are written. Kept OUTSIDE ./public so files are never
# statically served — they are only reachable through the authenticated
# /api/files/:id route. Swap this layer for S3 by implementing lib/storage.
STORAGE_DIR="./storage/uploads"

# Session lifetime in seconds (default 7 days).
SESSION_TTL_SECONDS="604800"

# Per-file upload ceiling in bytes (default 5 MB, as required by the spec).
MAX_UPLOAD_BYTES="5242880"
