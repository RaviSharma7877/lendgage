generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(254)
  password_hash String   @db.VarChar(255)
  full_name     String   @db.VarChar(160)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  applications  Application[]
  documents     Document[]

  @@map("users")
}

enum ApplicationStatus {
  SUBMITTED
  COMPLETED
}

model Application {
  id                    String            @id @default(uuid()) @db.Uuid
  user_id               String            @db.Uuid
  reference_number      String            @unique @db.VarChar(32)
  status                ApplicationStatus @default(SUBMITTED)

  full_name             String            @db.VarChar(160)
  date_of_birth         DateTime          @db.Date
  gender                String?           @db.VarChar(24)
  registration_number   String            @db.VarChar(64)
  course_name           String            @db.VarChar(160)
  institution_name      String            @db.VarChar(200)
  year_of_passing       Int               @db.SmallInt
  email                 String            @db.VarChar(254)
  phone                 String            @db.VarChar(24)
  address_line1         String            @db.VarChar(200)
  address_line2         String?           @db.VarChar(200)
  city                  String            @db.VarChar(100)
  state                 String            @db.VarChar(100)
  postal_code           String            @db.VarChar(16)

  certificate_serial    String?           @unique @db.VarChar(32)
  certificate_issued_at DateTime?

  submitted_at          DateTime          @default(now())
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  user                  User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  documents             Document[]

  @@unique([user_id, registration_number])
  @@index([user_id, created_at(sort: Desc)])
  @@map("applications")
}

enum DocumentType {
  ID_PROOF
  DEGREE_CERTIFICATE
}

model Document {
  id              String       @id @default(uuid()) @db.Uuid
  user_id         String       @db.Uuid
  application_id  String?      @db.Uuid
  doc_type        DocumentType
  original_name   String       @db.VarChar(255)
  storage_key     String       @unique @db.VarChar(255)
  mime_type       String       @db.VarChar(100)
  size_bytes      BigInt
  checksum_sha256 String       @db.Char(64)
  created_at      DateTime     @default(now())

  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  application     Application? @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@unique([application_id, doc_type])
  @@index([user_id, created_at(sort: Desc)])
  @@map("documents")
}

model CertificateSerial {
  serial     BigInt   @id @default(autoincrement())
  created_at DateTime @default(now())

  @@map("certificate_serials")
}
